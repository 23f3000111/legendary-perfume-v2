# Legendary storefront environment.
#
# Local:  copy this file to .env and fill it in.
# Vercel: set the same names under Project Settings, Environment Variables.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is public.
# Everything else stays on the server. Never prefix a secret.

# ---- Stripe -------------------------------------------------------------

# Publishable key. Public by design, and needs the VITE_ prefix to reach the
# browser at all.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Secret key. Used only by the functions under /api.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Signing secret for the webhook endpoint. Take it from the Stripe dashboard
# when you add the endpoint, or from `stripe listen --forward-to
# localhost:3000/api/webhook` while developing. Without it the webhook refuses
# every request, so payments are taken but orders never settle and no
# confirmation email goes out.
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret

# ---- Order storage ------------------------------------------------------

# Postgres connection string. Neon, Supabase and Vercel Postgres all work.
#
# Set this in production. It gives the house an order history of its own, and
# it removes the few seconds Stripe's search index takes to catch up after a
# sale. Left blank, orders are stored on their own Stripe payment instead,
# which is durable and fully functional but keeps no separate record.
DATABASE_URL=postgresql://postgres:LegendaryNoReply88%40@db.fpxbgsrltxzjvqqbvgsm.supabase.co:5432/postgres

# ---- Transactional email (Resend) ---------------------------------------

# Without a key, both emails are logged rather than sent and checkout still
# completes. That is what a fresh deployment does until Resend is set up.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, or nothing will send.
ORDER_FROM_EMAIL=Legendary <noreply@legendary.com.my>

# Where order notifications and contact form messages arrive.
ORDER_NOTIFY_EMAIL=noreply@legendary.com.my

# Anyone else who should get a copy, comma separated.
ORDER_NOTIFY_CC=legendaryteammy@gmail.com

# Where a customer's reply goes, if not the From address.
ORDER_REPLY_TO=noreply@legendary.com.my

# Only for a Postgres provider that publishes its own root certificate and is
# not Supabase, whose CA is already pinned in api/_lib/supabase-ca.ts. Paste the
# PEM in. There is no option to skip verification, by design.
DATABASE_CA_CERT=

# ---- Dashboard ----------------------------------------------------------

# The password for /admin. Leave it unset and the dashboard refuses every sign
# in, which is the right default: an unset password must never mean open doors.
ADMIN_PASSWORD=choose-a-long-passphrase

# Signs the admin session cookie. Optional: with nothing here it is derived
# from STRIPE_SECRET_KEY, which is already high entropy and already server
# only. Set it explicitly if you would rather rotating the Stripe key did not
# sign everyone out.
ADMIN_SESSION_SECRET=

# ---- Site ---------------------------------------------------------------

# Absolute origin. Used server side for the links inside emails, and at build
# time for canonical URLs, the sitemap, robots.txt and llms.txt.
SITE_URL=https://legendary.com.my

# The same origin, for the browser bundle's canonical tags. Keep them in step.
VITE_SITE_URL=https://legendary.com.my

# Only needed when the site and its API sit on different origins, such as a
# static preview talking to the Vercel deployment. Same origin: leave blank.
VITE_API_BASE=